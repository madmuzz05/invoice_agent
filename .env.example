# Salin ke .env lalu isi. Semua env di bawah dibaca oleh invoice_verifier/web/config.py.

# ── LLM ─────────────────────────────────────────────────────────────────────
# Mode OpenAI-compatible (dipakai jika OPENAI_BASE_URL diisi; model harus
# mendukung input gambar untuk dokumen scan/foto).
OPENAI_BASE_URL=https://your-provider.example.com/v1
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=your-model-name

# Tingkat reasoning model: low (default, cepat) / medium / high.
# Kosongkan (LLM_REASONING_EFFORT=) jika model tidak mendukung parameter ini.
LLM_REASONING_EFFORT=low
# Kirim gambar halaman scan/foto ke LLM; false = hanya teks OCR
LLM_SEND_PAGE_IMAGES=true
# Panggilan LLM bersamaan maksimum (semua job); PDF multi-dokumen = 1 + jumlah dokumen panggilan
LLM_MAX_PARALLEL_CALLS=4

# ── API ─────────────────────────────────────────────────────────────────────
# Header X-API-Key untuk /api/pinter/*; kosong = auth dimatikan (development saja)
PINTER_API_KEY=your-api-key-here
# Umur trx_id (hari); setelah itu /extract mengembalikan TRX_EXPIRED
PINTER_TRX_TTL_DAYS=7

# ── App ─────────────────────────────────────────────────────────────────────
# development | production (production menyembunyikan detail error)
APP_ENV=development
# 1 = aktifkan /docs (Swagger), 0 = matikan
ENABLE_DOCS=1

# ── Upload & penyimpanan ────────────────────────────────────────────────────
MAX_UPLOAD_MB=20
# Path relatif dihitung dari folder invoice_verifier/
UPLOAD_DIR=tmp_uploads
SQLITE_DB_PATH=data/invoice_verifier.db

# ── Job ─────────────────────────────────────────────────────────────────────
MAX_CONCURRENT_JOBS=10
# Detik sebelum job selesai dihapus dari memori (hasil tetap ada di SQLite)
JOB_TTL_SECONDS=3600
